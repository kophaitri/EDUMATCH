@model List<Notification>
@{ ViewData["Title"] = "Thông báo"; }

<div class="container py-4" style="max-width: 700px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold">Thông báo</h4>
            @if (ViewBag.UnreadCount > 0)
            {
                <small class="text-muted">@ViewBag.UnreadCount thông báo chưa đọc</small>
            }
        </div>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-check2-all me-1"></i>Đánh dấu tất cả đã đọc
                </button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-bell-slash" style="font-size: 3rem;"></i>
            <p class="mt-3">Bạn chưa có thông báo nào.</p>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var n in Model)
            {
                <div class="notification-item @(!n.IsRead ? "unread" : "")">
                    <div class="notif-icon">
                        <i class="bi bi-@(n.Type == NotificationType.System ? "megaphone" : "bell")"></i>
                    </div>
                    <div class="notif-content">
                        <div class="notif-title">
                            @n.Title
                            @if (!n.IsRead)
                            {
                                <span class="badge bg-primary ms-1" style="font-size:0.6rem;">Mới</span>
                            }
                        </div>
                        <div class="notif-message">@n.Message</div>
                        <div class="notif-time">
                            <i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("HH:mm — dd/MM/yyyy")
                        </div>
                        <div class="mt-2 d-flex gap-2">
                            @if (!string.IsNullOrEmpty(n.ActionUrl))
                            {
                                <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-arrow-right me-1"></i>Xem ngay
                                    </button>
                                </form>
                            }
                            else if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-check me-1"></i>Đánh dấu đã đọc
                                    </button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@n.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Xoá thông báo này?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
