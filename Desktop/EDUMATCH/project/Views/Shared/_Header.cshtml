<header>
    <nav class="nav">
        <div class="nav-logo">
            <div class="nav-logo-dot"></div>
            EduMatch
        </div>
        <ul class="nav-links">
            <li><a href="#">Tìm gia sư</a></li>
            <li><a href="#">Môn học</a></li>
            <li><a href="#">Trở thành gia sư</a></li>
            <li><a href="#">Bảng giá</a></li>
            <li><a href="#">Về chúng tôi</a></li>
        </ul>
        <div class="nav-cta">
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Account" asp-action="Profile" class="btn-ghost">Tài khoản</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline" style="display:inline;margin-left:8px;">
                    <button type="submit" class="btn-ghost">Đăng xuất</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-ghost">Đăng nhập</a>
                <a asp-controller="Account" asp-action="Register" class="btn-solid" style="margin-left:8px;">Đăng ký miễn phí</a>
            }
        </div>
    </nav>
</header>
