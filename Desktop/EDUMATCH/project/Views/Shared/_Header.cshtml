<header>
    <nav class="nav">
        <a href="/" class="nav-logo" style="text-decoration: none;">
            <div class="nav-logo-dot"></div>
            EduMatch
        </a>
        <ul class="nav-links">
            <li><a asp-controller="Student" asp-action="Search">Tìm gia sư</a></li>
            <li><a asp-controller="Student" asp-action="Subjects">Môn học</a></li>
            @if (User?.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Student"))
                {
                    <li><a asp-controller="Student" asp-action="Bookings">Yêu cầu học</a></li>
                    <li><a asp-controller="Student" asp-action="Contracts">Hợp đồng</a></li>
                    <li><a asp-controller="Student" asp-action="Schedule">Lịch học</a></li>
                }
                @if (User.IsInRole("Tutor"))
                {
                    <li><a asp-controller="Tutor" asp-action="ManageSubjects">Môn dạy</a></li>
                    <li><a asp-controller="Tutor" asp-action="Bookings">Yêu cầu dạy</a></li>
                    <li><a asp-controller="Tutor" asp-action="Contracts">Hợp đồng</a></li>
                    <li><a asp-controller="Tutor" asp-action="Posts">Bài viết</a></li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li><a asp-controller="Admin" asp-action="Tutors">Gia sư</a></li>
                    <li><a asp-controller="Admin" asp-action="Wallets">Quản lý ví</a></li>
                    <li><a asp-controller="Admin" asp-action="Transactions">Giao dịch</a></li>
                    <li><a asp-controller="Admin" asp-action="Payments">Thanh toán</a></li>
                }
            }
            else
            {
                <li><a href="#">Trở thành gia sư</a></li>
                <li><a href="#">Về chúng tôi</a></li>
            }
        </ul>
        <div class="nav-cta">
            @if (User?.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Student"))
                {
                    <a asp-controller="Student" asp-action="Wallet" class="btn-ghost">Ví tiền</a>
                }
                @if (User.IsInRole("Tutor"))
                {
                    <a asp-controller="Tutor" asp-action="Wallet" class="btn-ghost">Ví tiền</a>
                }
                <a asp-controller="Account" asp-action="Profile" class="btn-ghost">Tài khoản</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline" style="display:inline;margin-left:8px;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-ghost">Đăng xuất</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn-ghost">Đăng nhập</a>
                <a asp-controller="Account" asp-action="Register" class="btn-solid" style="margin-left:8px;">Đăng ký miễn phí</a>
            }
        </div>
    </nav>
</header>
