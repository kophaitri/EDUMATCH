@model int
@* model = số thông báo chưa đọc *@

<a href="/Notification/Index" class="nav-notification-bell" title="Thông báo (@Model chưa đọc)">
    <i class="bi bi-@(Model > 0 ? "bell-fill" : "bell")"></i>
    @if (Model > 0)
    {
        <span class="notification-badge">@(Model > 99 ? "99+" : Model.ToString())</span>
    }
</a>
