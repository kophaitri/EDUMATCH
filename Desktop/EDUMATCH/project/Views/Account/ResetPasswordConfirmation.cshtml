@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

@section Styles {
    @await Html.PartialAsync("_AuthStyles")
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <i class="bi bi-check-circle text-success" style="font-size: 64px;"></i>
                    </div>
                    <h2 class="mb-3">Đặt lại mật khẩu thành công!</h2>
                    <p class="text-muted mb-4">
                        Mật khẩu của bạn đã được đặt lại thành công. 
                        Bạn có thể đăng nhập với mật khẩu mới ngay bây giờ.
                    </p>
                    <a asp-action="Login" class="btn btn-primary btn-lg">Đăng nhập</a>
                </div>
            </div>
        </div>
    </div>
</div>
