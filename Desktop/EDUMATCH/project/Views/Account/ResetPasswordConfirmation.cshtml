@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

@section Styles {
    @await Html.PartialAsync("_AuthStyles")
}

<main class="flex-grow flex items-center justify-center px-6 py-24">
    <section class="w-full max-w-2xl">
        <!-- Card -->
        <div class="bg-white rounded-[14px] p-12 md:p-24 text-center editorial-shadow border border-gray-6/20 relative overflow-hidden card-fade-in">
            <div class="relative z-10 flex flex-col items-center">
                <!-- Icon -->
                <div class="w-24 h-24 rounded-full bg-black flex items-center justify-center mb-12">
                    <span class="material-symbols-outlined text-white text-5xl confirmation-icon" style="font-variation-settings: 'FILL' 0, 'wght' 200;">
                        lock_open
                    </span>
                </div>

                <!-- Title -->
                <div class="space-y-6 mb-12">
                    <h1 class="editorial-title text-4xl md:text-6xl font-black tracking-tight leading-none">
                        Mật khẩu đã được đặt lại!
                    </h1>
                    <p class="text-gray-4 text-lg max-w-md mx-auto leading-relaxed">
                        Mật khẩu của bạn đã được cập nhật thành công. Bạn có thể đăng nhập với mật khẩu mới ngay bây giờ.
                    </p>
                </div>

                <!-- Primary Action -->
                <div class="w-full max-w-xs mx-auto">
                    <a asp-action="Login" class="block w-full bg-black text-white py-5 rounded-xl font-bold text-sm label-technical text-center hover:opacity-90 active:scale-95 transition-all shadow-lg shadow-black/10 btn-transition no-underline">
                        ĐĂNG NHẬP NGAY
                    </a>
                </div>

                <!-- Metadata -->
                <div class="mt-12 pt-12 border-t border-gray-7 w-full">
                    <p class="text-[10px] uppercase tracking-[0.2em] text-gray-5 font-medium m-0">
                        EDUMATCH · KHÔI PHỤC MẬT KHẨU
                    </p>
                </div>
            </div>
        </div>

        <!-- Branding decoration -->
        <div class="mt-12 flex justify-center items-center gap-4 opacity-20">
            <div class="h-[1px] w-12 bg-black"></div>
            <span class="text-[10px] font-black tracking-tighter">EDUMATCH</span>
            <div class="h-[1px] w-12 bg-black"></div>
        </div>
    </section>
</main>
