@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@section Styles {
    @await Html.PartialAsync("_AuthStyles")
}

<main class="flex items-center justify-center min-h-screen px-6 py-24">
    <div class="max-w-2xl w-full">
        <!-- Card -->
        <div class="bg-white rounded-[14px] p-12 md:p-16 editorial-shadow border border-gray-6/20 card-fade-in">
            <!-- Header -->
            <div class="mb-12">
                <h1 class="editorial-title text-5xl font-black leading-tight">Đặt lại mật khẩu</h1>
                <p class="text-gray-4 mt-4 leading-relaxed">Nhập mật khẩu mới cho tài khoản của bạn</p>
                <div class="mt-4 w-12 h-1 bg-black"></div>
            </div>

            <!-- Form -->
            <form asp-action="ResetPassword" method="post" class="space-y-10">
                <div asp-validation-summary="ModelOnly" class="bg-red-50 text-red-700 px-4 py-3 rounded-lg text-sm border border-red-200"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <!-- Email (disabled) -->
                <div class="flex flex-col space-y-2">
                    <label class="text-[10px] tracking-widest uppercase font-bold text-gray-5">Email</label>
                    <input type="text" class="input-minimal w-full py-3 text-lg text-gray-5" value="@Model.Email" disabled />
                </div>

                <!-- New Password -->
                <div class="flex flex-col space-y-2">
                    <label asp-for="Password" class="text-[10px] tracking-widest uppercase font-bold text-gray-5"></label>
                    <input asp-for="Password" class="input-minimal w-full py-3 text-lg" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
                    <p class="text-[11px] text-gray-5 mt-2 font-medium">Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ và số</p>
                </div>

                <!-- Confirm Password -->
                <div class="flex flex-col space-y-2">
                    <label asp-for="ConfirmPassword" class="text-[10px] tracking-widest uppercase font-bold text-gray-5"></label>
                    <input asp-for="ConfirmPassword" class="input-minimal w-full py-3 text-lg" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
                </div>

                <!-- Actions -->
                <div class="flex flex-col sm:flex-row gap-4 pt-8">
                    <button type="submit" class="bg-black text-white px-10 py-4 rounded-xl font-bold text-sm tracking-wide hover:opacity-90 active:scale-95 transition-all btn-transition shadow-lg shadow-black/10">
                        Đặt lại mật khẩu
                    </button>
                    <a asp-action="Login" class="bg-transparent border border-gray-6 text-black px-10 py-4 rounded-xl font-bold text-sm tracking-wide text-center hover:bg-gray-8 active:scale-95 transition-all btn-transition no-underline">
                        Hủy
                    </a>
                </div>
            </form>
        </div>

        <!-- Metadata -->
        <div class="mt-12 text-center">
            <p class="text-[10px] tracking-[0.2em] uppercase text-gray-5 font-medium m-0">
                BẢO MẬT · EDUMATCH 2024
            </p>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
