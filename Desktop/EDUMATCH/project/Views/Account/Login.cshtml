@model LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng nhập - EduMatch";
}

@section Styles {
    @await Html.PartialAsync("_AuthStyles")
}

<div class="d-flex align-items-center justify-content-center" style="min-height:calc(100vh - 120px); padding:40px 16px;">
    <main class="w-full" style="max-width:480px; width:100%;">
        <div class="text-center mb-4">
            <span class="section-tag d-block mb-3">EduMatch / Auth</span>
            <h1 class="playfair-heading" style="font-size:2.5rem; font-weight:800;">Đăng <em style="font-style:italic;">nhập</em></h1>
            <p class="text-muted" style="color:var(--gray-5);">Chào mừng trở lại với EduMatch</p>
        </div>

        <div class="bg-white" style="border-radius:12px; padding:28px; box-shadow:0 8px 32px rgba(0,0,0,0.06); border:1px solid var(--gray-8);">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div style="margin-bottom:14px;">
                    <label class="d-block" for="Email" style="font-size:0.75rem; font-weight:700; text-transform:uppercase; color:var(--gray-3);">Email</label>
                    <input asp-for="Email" class="form-control" placeholder="example@email.com" style="width:100%; padding:12px 14px; border-radius:6px; border:1px solid transparent; background:var(--gray-8);" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div style="margin-bottom:10px;">
                    <label class="d-block" for="Password" style="font-size:0.75rem; font-weight:700; text-transform:uppercase; color:var(--gray-3);">Mật khẩu</label>
                    <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" style="width:100%; padding:12px 14px; border-radius:6px; border:1px solid transparent; background:var(--gray-8);" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3" style="font-size:0.9rem;">
                    <label style="display:flex; align-items:center; gap:8px;"><input type="checkbox" asp-for="RememberMe" /> <span style="color:var(--gray-5);">Ghi nhớ đăng nhập</span></label>
                    <a asp-controller="Account" asp-action="ForgotPassword" style="color:var(--gray-5);">Quên mật khẩu?</a>
                </div>

                <div>
                    <button type="submit" class="btn btn-primary" style="width:100%; padding:12px 16px; background:var(--black); border:none; color:var(--white); font-weight:700; border-radius:12px;">Đăng nhập</button>
                </div>
            </form>

            <div style="margin-top:18px; padding-top:16px; border-top:1px solid var(--gray-8); text-align:center;">
                <p style="margin:0;color:var(--gray-5);">Chưa có tài khoản? <a asp-controller="Account" asp-action="Register" style="color:var(--black); font-weight:700;">Đăng ký ngay</a></p>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

