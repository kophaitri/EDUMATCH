@model EditProfileViewModel
@{
    ViewData["Title"] = "Chỉnh sửa thông tin";
}

@section Styles {
    @await Html.PartialAsync("_AuthStyles")
}

<main class="max-w-4xl mx-auto py-[120px] px-6">
    <!-- Header Section -->
    <div class="mb-16">
        <p class="text-xs font-bold tracking-[0.2em] text-gray-5 mb-4 uppercase">EDUMATCH / CÀI ĐẶT</p>
        <h1 class="playfair-heading text-6xl md:text-7xl mb-6">Chỉnh sửa thông tin</h1>
        <p class="text-xl text-gray-5 font-body">
            Cập nhật thông tin cá nhân của bạn <span class="font-display italic text-gray-6">để kết nối tốt hơn</span>
        </p>
    </div>

    <!-- Edit Profile Card -->
    <div class="bg-white rounded-[14px] shadow-[0_4px_40px_rgba(0,0,0,0.07)] p-10 border border-gray-7 card-fade-in">
        <form asp-action="EditProfile" method="post" enctype="multipart/form-data" class="space-y-12">
            <div asp-validation-summary="ModelOnly" class="bg-red-50 text-red-700 px-4 py-3 rounded-lg text-sm border border-red-200"></div>

            <!-- Avatar Upload Section -->
            <div class="flex flex-col items-center gap-6">
                <div class="relative group">
                    <div class="w-40 h-40 rounded-full overflow-hidden border-4 border-gray-8 shadow-sm" id="avatarPreview">
                        @if (!string.IsNullOrEmpty(Model.CurrentAvatarUrl))
                        {
                            <img src="@Model.CurrentAvatarUrl" alt="Avatar" class="w-full h-full object-cover" id="avatarImg" />
                        }
                        else
                        {
                            <div class="w-full h-full bg-gray-7 flex items-center justify-center" id="avatarPlaceholder">
                                <span class="material-symbols-outlined text-gray-5 text-6xl">person</span>
                            </div>
                        }
                    </div>
                    <label class="absolute bottom-1 right-1 bg-black text-white p-2 rounded-full cursor-pointer hover:scale-105 transition-transform" for="avatarInput">
                        <span class="material-symbols-outlined text-sm">photo_camera</span>
                    </label>
                    <input asp-for="AvatarFile" type="file" accept="image/*" id="avatarInput" class="hidden" />
                </div>
                <div class="text-center">
                    <p class="font-bold text-lg">Ảnh đại diện</p>
                    <p class="text-sm text-gray-5">Nhấp vào máy ảnh để thay đổi ảnh</p>
                    <span asp-validation-for="AvatarFile" class="text-red-500 text-sm"></span>
                </div>
            </div>

            <!-- Form Fields -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="flex flex-col gap-2">
                    <label asp-for="FullName" class="text-xs font-bold uppercase tracking-wider text-gray-4"></label>
                    <input asp-for="FullName" class="w-full px-4 py-3 bg-transparent border border-gray-4 rounded-lg focus:ring-1 focus:ring-black focus:border-black transition-all outline-none" />
                    <span asp-validation-for="FullName" class="text-red-500 text-sm"></span>
                </div>
                <div class="flex flex-col gap-2">
                    <label asp-for="PhoneNumber" class="text-xs font-bold uppercase tracking-wider text-gray-4"></label>
                    <input asp-for="PhoneNumber" class="w-full px-4 py-3 bg-transparent border border-gray-4 rounded-lg focus:ring-1 focus:ring-black focus:border-black transition-all outline-none" />
                    <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-6 border-t border-gray-7">
                <a asp-action="Profile" class="w-full sm:w-auto px-10 py-3 border border-gray-4 rounded-xl text-gray-4 hover:bg-gray-8 transition-colors font-semibold text-center btn-transition no-underline">
                    Hủy
                </a>
                <button type="submit" class="w-full sm:w-auto px-10 py-3 bg-black text-white rounded-xl hover:opacity-80 transition-colors font-semibold shadow-md btn-transition">
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('avatarInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(ev) {
                    const container = document.getElementById('avatarPreview');
                    container.innerHTML = '<img src="' + ev.target.result + '" class="w-full h-full object-cover" />';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
