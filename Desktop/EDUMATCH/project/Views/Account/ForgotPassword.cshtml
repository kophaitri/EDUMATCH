@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    @await Html.PartialAsync("_AuthStyles")
}

<main class="flex-grow flex items-center justify-center px-6 py-24">
    <div class="max-w-xl w-full">
        <!-- Card -->
        <div class="bg-white rounded-[14px] p-10 md:p-16 card-hover-shadow border border-gray-6/20 card-fade-in">
            <!-- Section Tag -->
            <div class="mb-10 text-center">
                <span class="font-bold text-[10px] label-technical leading-none uppercase tracking-[2.5px]">
                    KHÔI PHỤC TÀI KHOẢN
                </span>
            </div>

            <!-- Title -->
            <h1 class="editorial-title text-4xl md:text-5xl font-black text-center mb-6 leading-tight">
                Quên mật khẩu? <br/>
                <span class="italic font-normal text-gray-5 text-3xl md:text-4xl font-brand">nhận link qua email</span>
            </h1>

            <!-- Description -->
            <p class="text-gray-4 text-center mb-12 leading-relaxed max-w-sm mx-auto">
                Vui lòng nhập địa chỉ email đã đăng ký. Chúng tôi sẽ gửi hướng dẫn khôi phục mật khẩu đến hộp thư của bạn.
            </p>

            <!-- Form -->
            <form asp-action="ForgotPassword" method="post" class="space-y-8">
                <div asp-validation-summary="ModelOnly" class="bg-red-50 text-red-700 px-4 py-3 rounded-lg text-sm border border-red-200"></div>

                <div class="space-y-2">
                    <label asp-for="Email" class="block text-[10px] font-bold uppercase tracking-widest text-gray-5 ml-1"></label>
                    <input asp-for="Email" class="input-bordered" placeholder="username@edumatch.edu.vn" autofocus />
                    <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                </div>

                <button type="submit" class="w-full bg-black text-white font-bold py-5 rounded-xl text-sm label-technical hover:opacity-90 active:scale-95 transition-all shadow-lg shadow-black/10 btn-transition">
                    GỬI LINK ĐẶT LẠI MẬT KHẨU
                </button>
            </form>

            <!-- Back to login -->
            <div class="mt-12 text-center">
                <a asp-action="Login" class="inline-flex items-center gap-2 text-gray-5 text-sm font-medium hover:text-black transition-colors group no-underline">
                    <span class="material-symbols-outlined text-sm group-hover:-translate-x-1 transition-transform">arrow_back</span>
                    <span>Quay lại đăng nhập</span>
                </a>
            </div>
        </div>

        <!-- Branding decoration -->
        <div class="mt-12 flex justify-center items-center gap-4 opacity-20">
            <div class="h-[1px] w-12 bg-black"></div>
            <span class="text-[10px] font-black tracking-tighter">EDUMATCH</span>
            <div class="h-[1px] w-12 bg-black"></div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
