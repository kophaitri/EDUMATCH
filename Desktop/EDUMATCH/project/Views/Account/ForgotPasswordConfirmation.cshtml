@{
    ViewData["Title"] = "Xác nhận quên mật khẩu";
}

@section Styles {
    @await Html.PartialAsync("_AuthStyles")
}

<main class="flex-grow flex items-center justify-center px-6 py-24">
    <div class="w-full max-w-xl">
        <!-- Card -->
        <div class="bg-white rounded-[14px] editorial-shadow p-10 md:p-16 border border-gray-6/20 flex flex-col items-center text-center card-fade-in">
            <!-- Icon -->
            <div class="mb-10 text-black">
                <span class="material-symbols-outlined confirmation-icon">
                    mail
                </span>
            </div>

            <!-- Title -->
            <h1 class="editorial-title text-4xl md:text-5xl font-black text-center mb-6 leading-tight tracking-tight">
                Kiểm tra email của bạn.
            </h1>

            <!-- Description -->
            <p class="text-gray-4 text-lg leading-relaxed mb-8 max-w-md">
                Chúng tôi đã gửi link đặt lại mật khẩu đến email của bạn. Vui lòng kiểm tra hộp thư và làm theo hướng dẫn.
            </p>

            <!-- Italic accent -->
            <p class="italic text-sm text-gray-5 mb-12 font-light font-brand">
                "Nếu không thấy email, hãy kiểm tra thư mục spam hoặc thư rác."
            </p>

            <!-- Primary Action -->
            <div class="w-full pt-4">
                <a asp-action="Login" class="w-full py-5 px-8 bg-black text-white rounded-xl font-bold text-sm label-technical flex items-center justify-center gap-2 hover:opacity-90 active:scale-95 transition-all shadow-lg shadow-black/10 btn-transition no-underline">
                    QUAY LẠI ĐĂNG NHẬP
                </a>
            </div>

            <!-- Secondary link -->
            <div class="mt-8">
                <a asp-action="ForgotPassword" class="text-[10px] uppercase tracking-[0.15em] font-bold text-gray-5 hover:text-black transition-colors border-b border-transparent hover:border-black pb-1 no-underline">
                    Gửi lại email yêu cầu
                </a>
            </div>
        </div>

        <!-- Branding decoration -->
        <div class="mt-12 flex justify-center items-center gap-4 opacity-20">
            <div class="h-[1px] w-12 bg-black"></div>
            <span class="text-[10px] font-black tracking-tighter">EDUMATCH</span>
            <div class="h-[1px] w-12 bg-black"></div>
        </div>
    </div>
</main>
