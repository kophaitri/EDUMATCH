@model List<EduMatch.Services.SubmissionFraudSummary>
@{
    ViewData["Title"] = "Giám sát gian lận";

    string LevelLabel(string level) => level switch
    {
        "Clean" => "An toàn",
        "Suspicious" => "Nghi ngờ",
        "Flagged" => "Cảnh báo",
        _ => level
    };
}

<div class="fraud-page mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0"><i class="bi bi-shield-exclamation"></i> Giám sát gian lận</h4>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Chưa có dữ liệu giám sát gian lận.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover fraud-table">
                <thead>
                    <tr>
                        <th>Học viên</th>
                        <th>Bài thi</th>
                        <th>Điểm nghi ngờ</th>
                        <th>Mức độ</th>
                        <th>Thời gian</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.StudentName</td>
                            <td>@item.ExamTitle</td>
                            <td>
                                <div class="fraud-score-bar">
                                    <div class="fraud-score-fill fraud-score-fill--@item.Level.ToLower()"
                                         style="width: @item.TotalScore%"></div>
                                    <span class="fraud-score-text">@item.TotalScore.ToString("F0")</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge fraud-badge fraud-badge--@item.Level.ToLower()">
                                    @LevelLabel(item.Level)
                                </span>
                            </td>
                            <td>@item.CalculatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a asp-action="Detail" asp-route-submissionId="@item.SubmissionId"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
