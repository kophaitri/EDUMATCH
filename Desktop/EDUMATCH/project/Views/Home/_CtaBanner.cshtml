@{
    Layout = null;
}
<section class="cta-banner reveal">
    <div class="cta-inner">
        <div class="cta-left">
            <h2 class="cta-title">Bạn muốn học hay muốn dạy?</h2>
            <p class="cta-desc">EduMatch phục vụ cả hai. Dù bạn là học viên đang tìm thầy hay gia sư muốn mở rộng thu nhập — chúng tôi có chỗ cho bạn.</p>
        </div>
        <div class="cta-right">
            <div class="cta-item">
                <div class="cta-item-icon">👩‍🎓</div>
                <div class="cta-item-text">
                    <div class="cta-item-title">Tôi muốn tìm gia sư</div>
                    <div class="cta-item-desc">Tìm kiếm, đặt lịch, học ngay hôm nay</div>
                </div>
                <div class="cta-item-arrow">→</div>
            </div>
            <div class="cta-item">
                <div class="cta-item-icon">🧑‍🏫</div>
                <div class="cta-item-text">
                    <div class="cta-item-title">Tôi muốn trở thành gia sư</div>
                    <div class="cta-item-desc">Tạo hồ sơ, nhận học viên, tăng thu nhập</div>
                </div>
                <div class="cta-item-arrow">→</div>
            </div>
        </div>
    </div>
</section>
