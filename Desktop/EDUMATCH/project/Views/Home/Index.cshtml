@{
    Layout = "_Layout";
    ViewData["Title"] = "EduMatch — Trang chủ";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@* Page body: render modular partials *@
@await Html.PartialAsync("_Hero")
@await Html.PartialAsync("_BannerCarousel")
@await Html.PartialAsync("_Marquee")
@await Html.PartialAsync("_Search")
@await Html.PartialAsync("_HowItWorks")
@await Html.PartialAsync("_Subjects")
@await Html.PartialAsync("_FeaturedTutors")
@await Html.PartialAsync("_Reviews")
@await Html.PartialAsync("_CtaBanner")

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}

