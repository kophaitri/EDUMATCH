@model SupportTicket
@{ ViewData["Title"] = "Ticket #" + Model.Id; }

<div class="container py-4" style="max-width: 760px;">
    <div class="mb-3">
        <a asp-action="MyTickets" class="text-muted text-decoration-none small">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
        <div>
            <h5 class="fw-bold mb-1">Ticket #@Model.Id — @Model.Subject</h5>
            <div class="text-muted small">
                <i class="bi bi-clock me-1"></i>Gửi lúc @Model.CreatedAt.ToString("HH:mm — dd/MM/yyyy")
                @if (Model.AssignedTo != null)
                {
                    <span class="ms-2"><i class="bi bi-person-check me-1"></i>Phụ trách: @Model.AssignedTo.FullName</span>
                }
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @switch (Model.Status)
            {
                case TicketStatus.Open:       <span class="badge bg-primary">Mở</span> break;
                case TicketStatus.InProgress: <span class="badge bg-warning text-dark">Đang xử lý</span> break;
                case TicketStatus.Resolved:   <span class="badge bg-success">Đã giải quyết</span> break;
                case TicketStatus.Closed:     <span class="badge bg-secondary">Đã đóng</span> break;
            }
            @switch (Model.Priority)
            {
                case TicketPriority.Urgent: <span class="badge bg-danger">Khẩn cấp</span> break;
                case TicketPriority.High:   <span class="badge bg-warning text-dark">Cao</span> break;
                case TicketPriority.Medium: <span class="badge bg-info text-dark">Trung bình</span> break;
                case TicketPriority.Low:    <span class="badge bg-light text-dark">Thấp</span> break;
            }
        </div>
    </div>

    @* Original message *@
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header d-flex justify-content-between align-items-center bg-light">
            <span class="fw-semibold small"><i class="bi bi-person-circle me-1"></i>Bạn</span>
            <small class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
        </div>
        <div class="card-body">
            <p class="mb-0" style="white-space:pre-wrap">@Model.Description</p>
        </div>
    </div>

    @* Replies *@
    @foreach (var r in Model.Replies.OrderBy(x => x.CreatedAt))
    {
        <div class="card border-0 shadow-sm mb-2 @(r.IsStaffReply ? "border-start border-4 border-primary" : "")">
            <div class="card-header d-flex justify-content-between align-items-center @(r.IsStaffReply ? "bg-primary bg-opacity-10" : "bg-light")">
                <span class="fw-semibold small">
                    @if (r.IsStaffReply)
                    {
                        <i class="bi bi-shield-fill text-primary me-1"></i>
                        @r.Sender.FullName
                        <span class="badge bg-primary ms-1" style="font-size:0.6rem;">Admin</span>
                    }
                    else
                    {
                        <i class="bi bi-person-circle me-1"></i>
                        <span>Bạn</span>
                    }
                </span>
                <small class="text-muted">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
            </div>
            <div class="card-body">
                <p class="mb-0" style="white-space:pre-wrap">@r.Content</p>
            </div>
        </div>
    }

    @* Reply form *@
    @if (Model.Status != TicketStatus.Closed)
    {
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-light">
                <span class="fw-semibold small"><i class="bi bi-reply me-1"></i>Phản hồi thêm</span>
            </div>
            <div class="card-body">
                <form asp-action="Reply" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <textarea name="content" class="form-control mb-3" rows="4"
                              placeholder="Thêm thông tin hoặc phản hồi..." required></textarea>
                    <button type="submit" class="btn btn-dark btn-sm">
                        <i class="bi bi-send me-1"></i>Gửi phản hồi
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-secondary mt-3">
            <i class="bi bi-lock me-1"></i>Ticket này đã đóng. Nếu vẫn cần hỗ trợ, vui lòng
            <a asp-action="Create">tạo ticket mới</a>.
        </div>
    }
</div>
