@model List<SupportTicket>
@{ ViewData["Title"] = "Ticket hỗ trợ của tôi"; }

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0">Ticket hỗ trợ của tôi</h4>
            <small class="text-muted">@Model.Count ticket · @Model.Count(t => t.Status == TicketStatus.Open || t.Status == TicketStatus.InProgress) đang xử lý</small>
        </div>
        <a asp-action="Create" class="btn btn-dark btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Tạo ticket mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-headset" style="font-size: 3rem;"></i>
            <p class="mt-3">Bạn chưa có ticket hỗ trợ nào.</p>
            <a asp-action="Create" class="btn btn-dark">Tạo ticket đầu tiên</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var t in Model)
            {
                <a asp-action="TicketDetail" asp-route-id="@t.Id"
                   class="ticket-card text-decoration-none text-dark">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1 me-3">
                            <div class="fw-semibold mb-1">@t.Subject</div>
                            <div class="text-muted small">
                                <i class="bi bi-clock me-1"></i>@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                <span class="ms-2">
                                    <i class="bi bi-chat-text me-1"></i>@t.Replies.Count phản hồi
                                </span>
                            </div>
                        </div>
                        <div class="d-flex flex-column align-items-end gap-1">
                            @switch (t.Status)
                            {
                                case TicketStatus.Open:
                                    <span class="badge bg-primary">Mở</span>
                                    break;
                                case TicketStatus.InProgress:
                                    <span class="badge bg-warning text-dark">Đang xử lý</span>
                                    break;
                                case TicketStatus.Resolved:
                                    <span class="badge bg-success">Đã giải quyết</span>
                                    break;
                                case TicketStatus.Closed:
                                    <span class="badge bg-secondary">Đã đóng</span>
                                    break;
                            }
                            @switch (t.Priority)
                            {
                                case TicketPriority.Urgent:
                                    <span class="badge bg-danger" style="font-size:0.6rem;">Khẩn cấp</span>
                                    break;
                                case TicketPriority.High:
                                    <span class="badge bg-warning text-dark" style="font-size:0.6rem;">Cao</span>
                                    break;
                                default: break;
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
