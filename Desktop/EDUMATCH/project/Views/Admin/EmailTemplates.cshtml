@model List<EmailTemplateListDto>
@{ ViewData["Title"] = "Email Templates"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Email Templates</h4>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createModal">+ Tạo mới</button>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>Code</th><th>Tiêu đề</th><th>Trạng thái</th><th>Cập nhật</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td><code>@t.TemplateCode</code></td>
                    <td>@t.Subject</td>
                    <td>
                        @if (t.IsActive) { <span class="badge bg-success">Hoạt động</span> }
                        else { <span class="badge bg-secondary">Tắt</span> }
                    </td>
                    <td>@t.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="d-flex gap-1">
                        <a asp-action="EmailTemplateDetail" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <form asp-action="ToggleEmailTemplateActive" asp-route-id="@t.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                @(t.IsActive ? "Tắt" : "Bật")
                            </button>
                        </form>
                        <form asp-action="DeleteEmailTemplate" asp-route-id="@t.Id" method="post"
                              onsubmit="return confirm('Xóa template này?')">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger">Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal tạo mới -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tạo Email Template mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateEmailTemplate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Template Code <span class="text-danger">*</span></label>
                        <input name="TemplateCode" class="form-control" placeholder="VD: WELCOME_EMAIL" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tiêu đề email <span class="text-danger">*</span></label>
                        <input name="Subject" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Nội dung HTML</label>
                        <textarea name="BodyHtml" class="form-control" rows="6"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Nội dung text (tùy chọn)</label>
                        <textarea name="BodyText" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input name="IsActive" type="checkbox" class="form-check-input" id="isActiveCreate" value="true" checked />
                            <label class="form-check-label" for="isActiveCreate">Kích hoạt ngay</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>
