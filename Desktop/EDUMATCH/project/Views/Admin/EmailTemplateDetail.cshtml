@model EmailTemplateDetailDto
@{ ViewData["Title"] = "Chi tiết Email Template"; }

<h4 class="mb-1">Email Template: <code>@Model.TemplateCode</code></h4>
<a asp-action="EmailTemplates" class="btn btn-outline-secondary btn-sm mb-3">← Quay lại</a>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Chỉnh sửa template</strong>
        <span>
            Tạo: @Model.CreatedAt.ToString("dd/MM/yyyy") &nbsp;|&nbsp; Cập nhật: @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
        </span>
    </div>
    <div class="card-body">
        <form asp-action="UpdateEmailTemplate" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label fw-semibold">Tiêu đề email <span class="text-danger">*</span></label>
                <input name="Subject" class="form-control" value="@Model.Subject" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Nội dung HTML</label>
                <textarea name="BodyHtml" class="form-control font-monospace" rows="12">@Model.BodyHtml</textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Nội dung text (tùy chọn)</label>
                <textarea name="BodyText" class="form-control" rows="4">@Model.BodyText</textarea>
            </div>
            <div class="mb-3">
                <div class="form-check">
                    <input name="IsActive" type="checkbox" class="form-check-input" id="isActive"
                           value="true" @(Model.IsActive ? "checked" : "") />
                    <label class="form-check-label" for="isActive">Kích hoạt</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </form>
    </div>
</div>
