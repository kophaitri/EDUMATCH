@model List<Wallet>
@{ ViewData["Title"] = "Quản lý ví người dùng"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Quản lý ví người dùng</h4>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo tên hoặc email..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Tìm</button>
        <a asp-action="Wallets" class="btn btn-outline-secondary">Xoá</a>
    </div>
</form>

<div class="row mb-3">
    <div class="col-md-4">
        <div class="card bg-primary text-white text-center p-3">
            <div>Tổng số dư toàn hệ thống</div>
            <h4>@(((decimal)ViewBag.TotalBalance).ToString("N0")) VNĐ</h4>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>#</th><th>Người dùng</th><th>Email</th><th>Vai trò</th><th>Số dư</th><th>Giao dịch</th><th>Cập nhật</th></tr>
        </thead>
        <tbody>
            @foreach (var w in Model)
            {
                <tr>
                    <td>@w.Id</td>
                    <td>@w.User.FullName</td>
                    <td>@w.User.Email</td>
                    <td>
                        @if (w.User.TutorProfile != null)
                        {
                            <span class="badge bg-warning text-dark">Gia sư</span>
                        }
                        else if (w.User.StudentProfile != null)
                        {
                            <span class="badge bg-info text-dark">Học viên</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                    </td>
                    <td class="fw-bold text-primary">@w.Balance.ToString("N0") VNĐ</td>
                    <td>@w.Transactions.Count giao dịch</td>
                    <td>@w.UpdatedAt.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
