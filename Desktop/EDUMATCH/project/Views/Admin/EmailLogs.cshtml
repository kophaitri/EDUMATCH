@model List<EmailLogListDto>
@{
    ViewData["Title"] = "Email Logs";
    int page = ViewBag.Page ?? 1;
    int total = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 50;
    int totalPages = (int)Math.Ceiling((double)total / pageSize);
}

<h4 class="mb-3">Email Logs <small class="text-muted fs-6">(@total bản ghi)</small></h4>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <select name="success" class="form-select">
            <option value="">-- Tất cả --</option>
            <option value="true" selected="@(ViewBag.FilterSuccess?.ToString() == "True")">Thành công</option>
            <option value="false" selected="@(ViewBag.FilterSuccess?.ToString() == "False")">Thất bại</option>
        </select>
    </div>
    <div class="col-md-4">
        <input name="search" class="form-control" placeholder="Email hoặc tiêu đề..." value="@ViewBag.Search" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Lọc</button>
        <a asp-action="EmailLogs" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr><th>#</th><th>Đến</th><th>Tiêu đề</th><th>KQ</th><th>Lỗi</th><th>Gửi lúc</th></tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.Id</td>
                    <td>@log.ToEmail</td>
                    <td>@log.Subject</td>
                    <td>
                        @if (log.IsSuccess) { <span class="badge bg-success">OK</span> }
                        else { <span class="badge bg-danger">Lỗi</span> }
                    </td>
                    <td><small class="text-danger">@log.ErrorMessage</small></td>
                    <td>@log.SentAt.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-action="EmailLogs"
                       asp-route-page="@i"
                       asp-route-success="@ViewBag.FilterSuccess"
                       asp-route-search="@ViewBag.Search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
