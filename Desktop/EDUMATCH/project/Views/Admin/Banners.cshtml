@model List<BannerDto>
@{ ViewData["Title"] = "Quản lý Banner"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Banners</h4>
    <a asp-action="BannerDetail" asp-route-id="0" class="btn btn-primary btn-sm">+ Thêm banner</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có banner nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr><th>Thứ tự</th><th>Tiêu đề</th><th>Thời gian</th><th>Trạng thái</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.DisplayOrder</td>
                        <td>
                            @if (b.ImageUrl != null)
                            {
                                <img src="@b.ImageUrl" style="width:60px;height:36px;object-fit:cover;border-radius:4px" class="me-2" alt="" />
                            }
                            <strong>@b.Title</strong>
                            @if (b.Description != null) { <div class="text-muted small">@b.Description</div> }
                        </td>
                        <td>
                            <small>@b.StartAt.ToString("dd/MM/yy") → @b.EndAt.ToString("dd/MM/yy")</small>
                            @if (b.EndAt < DateTime.UtcNow) { <span class="badge bg-secondary ms-1">Hết hạn</span> }
                        </td>
                        <td>
                            @if (b.IsCurrentlyActive)  { <span class="badge bg-success">Đang hiển thị</span> }
                            else if (b.IsActive)        { <span class="badge bg-warning text-dark">Đã bật / chờ thời gian</span> }
                            else                        { <span class="badge bg-secondary">Tắt</span> }
                        </td>
                        <td class="d-flex gap-1">
                            <a asp-action="BannerDetail" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="ToggleBannerActive" asp-route-id="@b.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm @(b.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                    @(b.IsActive ? "Tắt" : "Bật")
                                </button>
                            </form>
                            <form asp-action="DeleteBanner" asp-route-id="@b.Id" method="post"
                                  onsubmit="return confirm('Xóa banner này?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
