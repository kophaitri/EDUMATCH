@model AdminUserDetailDto
@{ ViewData["Title"] = "Chi tiết người dùng"; }

<h4 class="mb-1">@Model.FullName</h4>
<a asp-action="Users" class="btn btn-outline-secondary btn-sm mb-3">← Quay lại</a>

<div class="row g-3">
    <!-- Thông tin cơ bản -->
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body text-center pb-3">
                @if (Model.AvatarUrl != null)
                {
                    <img src="@Model.AvatarUrl" class="rounded-circle mb-2" width="80" height="80" style="object-fit:cover" alt="" />
                }
                else
                {
                    <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto mb-2 fw-bold fs-3" style="width:80px;height:80px">
                        @Model.FullName.FirstOrDefault()
                    </div>
                }
                <h5 class="mb-0">@Model.FullName</h5>
                <div class="text-muted small">@Model.Email</div>
                <div class="mt-2">
                    @switch (Model.Role)
                    {
                        case "Admin":   <span class="badge bg-danger">Admin</span>  break;
                        case "Tutor":   <span class="badge bg-success">Gia sư</span> break;
                        case "Student": <span class="badge bg-primary">Học viên</span> break;
                        default:        <span class="badge bg-secondary">@Model.Role</span> break;
                    }
                    @if (Model.IsActive) { <span class="badge bg-success ms-1">Hoạt động</span> }
                    else                 { <span class="badge bg-danger ms-1">Bị khoá</span> }
                </div>
            </div>
            <div class="card-body border-top pt-2">
                <p class="mb-1"><strong>Email:</strong> @Model.Email
                    @if (Model.EmailConfirmed) { <i class="bi bi-patch-check-fill text-success" title="Đã xác nhận"></i> }
                </p>
                <p class="mb-1"><strong>SĐT:</strong> @(Model.PhoneNumber ?? "—")</p>
                <p class="mb-1"><strong>Đăng nhập cuối:</strong> @(Model.LastLoginAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</p>
                <p class="mb-1"><strong>Tạo lúc:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                @if (Model.LockoutEnd.HasValue && Model.LockoutEnd > DateTimeOffset.UtcNow)
                {
                    <p class="mb-1 text-danger"><strong>Khoá đến:</strong> @(Model.LockoutEnd == DateTimeOffset.MaxValue ? "Vô thời hạn" : Model.LockoutEnd.Value.ToString("dd/MM/yyyy HH:mm"))</p>
                }
            </div>
            <div class="card-footer">
                <form asp-action="ToggleUserActive" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <button type="submit" class="btn w-100 @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                            onclick="return confirm('@(Model.IsActive ? "Khoá tài khoản này?" : "Mở khoá tài khoản này?")')">
                        @(Model.IsActive ? "Khoá tài khoản" : "Mở khoá tài khoản")
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Hồ sơ Gia sư -->
    <div class="col-md-8">
        @if (Model.TutorProfile != null)
        {
            var tp = Model.TutorProfile;
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between">
                    <strong>Hồ sơ Gia sư</strong>
                    @if (tp.IsVerified) { <span class="badge bg-success">Đã xác minh</span> }
                    else               { <span class="badge bg-warning text-dark">Chờ xác minh</span> }
                </div>
                <div class="card-body row g-2">
                    <div class="col-6"><strong>Kinh nghiệm:</strong> @tp.YearsOfExperience năm</div>
                    <div class="col-6"><strong>Học phí:</strong> @tp.HourlyRateMin.ToString("N0")–@tp.HourlyRateMax.ToString("N0") VNĐ/h</div>
                    <div class="col-6"><strong>Đánh giá TB:</strong> ⭐ @tp.AvgRating.ToString("F1") (@tp.TotalReviews đánh giá)</div>
                    <div class="col-6"><strong>Điểm uy tín:</strong> @tp.ReputationScore.ToString("F1")</div>
                    @if (tp.Bio != null) { <div class="col-12"><strong>Bio:</strong> @tp.Bio</div> }
                    @if (tp.Education != null) { <div class="col-12"><strong>Học vấn:</strong> @tp.Education</div> }
                </div>
                @if (tp.Certificates.Any())
                {
                    <div class="card-body border-top pt-2">
                        <strong>Bằng cấp / Chứng chỉ:</strong>
                        <ul class="mt-1 mb-0">
                            @foreach (var c in tp.Certificates)
                            {
                                <li>
                                    @c.Title @(c.Issuer != null ? $"— {c.Issuer}" : "")
                                    @(c.IssueDate.HasValue ? $" ({c.IssueDate.Value:MM/yyyy})" : "")
                                    @if (c.IsVerified) { <span class="badge bg-success">Đã duyệt</span> }
                                    else               { <span class="badge bg-warning text-dark">Chưa duyệt</span> }
                                    @if (c.FileUrl != null) { <a href="@c.FileUrl" target="_blank" class="ms-1 small">Xem file</a> }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

        @if (Model.StudentProfile != null)
        {
            var sp = Model.StudentProfile;
            <div class="card shadow-sm mb-3">
                <div class="card-header"><strong>Hồ sơ Học viên</strong></div>
                <div class="card-body row g-2">
                    <div class="col-6"><strong>Lớp hiện tại:</strong> @(sp.CurrentGrade ?? "—")</div>
                    <div class="col-6"><strong>Trường:</strong> @(sp.SchoolName ?? "—")</div>
                    @if (sp.LearningGoals != null)
                    { <div class="col-12"><strong>Mục tiêu:</strong> @sp.LearningGoals</div> }
                </div>
            </div>
        }

        @if (Model.TutorProfile == null && Model.StudentProfile == null)
        {
            <div class="alert alert-info">Người dùng này chưa có hồ sơ gia sư hoặc học viên.</div>
        }
    </div>
</div>
