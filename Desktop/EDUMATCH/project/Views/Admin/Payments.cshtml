@model List<PaymentOrder>
@{ ViewData["Title"] = "Payment Orders"; }

<h4 class="mb-4">Tất cả Payment Orders</h4>

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có payment order nào.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr><th>#</th><th>Người dùng</th><th>Phương thức</th><th>Mã giao dịch</th><th>Số tiền</th><th>Ngày tạo</th><th>Trạng thái</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.User.FullName</td>
                        <td><span class="badge bg-secondary">@p.PaymentMethod</span></td>
                        <td><code>@p.PaymentGatewayOrderId</code></td>
                        <td class="fw-bold">@p.Amount.ToString("N0") VNĐ</td>
                        <td>@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @switch (p.Status)
                            {
                                case TransactionStatus.Completed: <span class="badge bg-success">Thành công</span> break;
                                case TransactionStatus.Pending: <span class="badge bg-warning text-dark">Đang xử lý</span> break;
                                default: <span class="badge bg-danger">Thất bại</span> break;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
