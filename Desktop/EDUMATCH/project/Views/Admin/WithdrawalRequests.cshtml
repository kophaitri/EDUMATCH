@model IEnumerable<EduMatch.Models.WithdrawalRequest>
@{ ViewData["Title"] = "Yêu cầu rút tiền"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Yêu cầu rút tiền</h4>
    <span class="badge bg-warning text-dark fs-6">@Model.Count(r => r.Status == EduMatch.Models.Enums.WithdrawalStatus.Pending) chờ duyệt</span>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Gia sư</th>
                    <th>Số tiền</th>
                    <th>Ngân hàng</th>
                    <th>Số tài khoản</th>
                    <th>Tên TK</th>
                    <th>Ngày yêu cầu</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Id</td>
                        <td><strong>@r.Tutor?.FullName</strong></td>
                        <td><strong class="text-primary">@r.Amount.ToString("N0") VNĐ</strong></td>
                        <td>@r.BankName</td>
                        <td>@r.AccountNumber</td>
                        <td>@r.AccountName</td>
                        <td>@r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (r.Status == EduMatch.Models.Enums.WithdrawalStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Chờ duyệt</span>
                            }
                            else if (r.Status == EduMatch.Models.Enums.WithdrawalStatus.Approved)
                            {
                                <span class="badge bg-success">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Từ chối</span>
                            }
                        </td>
                        <td>
                            @if (r.Status == EduMatch.Models.Enums.WithdrawalStatus.Pending)
                            {
                                <div class="d-flex gap-1">
                                    <form asp-action="ApproveWithdrawal" method="post" onsubmit="return confirm('Xác nhận đã chuyển khoản cho gia sư?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button class="btn btn-success btn-sm">Duyệt</button>
                                    </form>
                                    <form asp-action="RejectWithdrawal" method="post" onsubmit="return confirm('Từ chối yêu cầu này?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button class="btn btn-danger btn-sm">Từ chối</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <small class="text-muted">@r.ProcessedAt?.ToLocalTime().ToString("dd/MM HH:mm")</small>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
