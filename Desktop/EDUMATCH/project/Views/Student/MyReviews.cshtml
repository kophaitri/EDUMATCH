@model IEnumerable<EduMatch.Models.Review>
@{
    ViewData["Title"] = "Quản lý đánh giá của tôi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📊 Đánh giá của tôi</h2>
        <!-- ✅ FIX: Dùng asp-controller + asp-action -->
        <a asp-controller="Student" asp-action="Contracts" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Viết đánh giá mới
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Bạn chưa có đánh giá nào.
            <br><br>
            <a asp-controller="Student" asp-action="Contracts" class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-check"></i> Xem hợp đồng để viết đánh giá
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var review in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <h5 class="card-title mb-0">
                                    @review.Contract.Tutor.FullName
                                </h5>
                                <a asp-controller="Student" asp-action="EditReview" asp-route-id="@review.Id" 
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                            
                            <small class="text-muted d-block mb-2">
                                <i class="bi bi-book"></i> @review.Contract.Subject.Name
                            </small>
                            
                            <div class="mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="text-@(i <= review.Rating ? "warning" : "light") fs-5">★</span>
                                }
                                <small class="text-muted ms-2">@review.Rating/5</small>
                            </div>
                            
                            <p class="card-text">@review.Comment</p>
                            
                            <small class="text-muted">
                                <i class="bi bi-calendar"></i> @review.CreatedAt.ToString("dd/MM/yyyy")
                            </small>
                            
                            @if (review.Reply != null)
                            {
                                <div class="alert alert-light mt-3 border-start border-4 border-primary">
                                    <small><strong>💬 Phản hồi từ gia sư:</strong></small><br>
                                    @review.Reply.ReplyText
                                    <br><small class="text-muted">@review.Reply.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4 text-center">
        <a asp-controller="Student" asp-action="Contracts" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại hợp đồng
        </a>
    </div>
</div>