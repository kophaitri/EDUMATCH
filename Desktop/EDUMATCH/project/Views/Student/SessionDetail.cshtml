@model Session
@{ ViewData["Title"] = "Chi tiết buổi học"; }

<h4 class="mb-3">Chi tiết buổi học</h4>
<a asp-action="Schedule" class="btn btn-outline-secondary btn-sm mb-3">← Quay lại lịch học</a>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Gia sư:</strong> @Model.Contract.Tutor.FullName</p>
                <p><strong>Môn học:</strong> @Model.Contract.Subject.Name</p>
                <p><strong>Thời gian:</strong> @Model.ScheduledAt.ToString("HH:mm - dd/MM/yyyy")</p>
                <p><strong>Thời lượng:</strong> @Model.DurationMinutes phút</p>
                <p><strong>Trạng thái:</strong>
                    @switch (Model.Status)
                    {
                        case SessionStatus.Scheduled: <span class="badge bg-info text-dark">Sắp tới</span> break;
                        case SessionStatus.InProgress: <span class="badge bg-primary">Đang diễn ra</span> break;
                        case SessionStatus.PendingConfirmation: <span class="badge bg-warning text-dark">Chờ xác nhận</span> break;
                        case SessionStatus.Completed: <span class="badge bg-success">Hoàn thành</span> break;
                        case SessionStatus.NoShow: <span class="badge bg-dark">Vắng mặt</span> break;
                        default: <span class="badge bg-secondary">Đã huỷ</span> break;
                    }
                </p>
                @if (Model.Status == SessionStatus.PendingConfirmation)
                {
                    <form asp-action="ConfirmSession" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="sessionId" value="@Model.Id" />
                        <button type="submit" class="btn btn-success"
                                onclick="return confirm('Xác nhận buổi học đã hoàn thành?')">
                            Xác nhận hoàn thành
                        </button>
                    </form>
                }
                @if (Model.StartedAt.HasValue)
                {
                    <p><strong>Bắt đầu lúc:</strong> @Model.StartedAt.Value.ToString("HH:mm dd/MM/yyyy")</p>
                }
                @if (Model.EndedAt.HasValue)
                {
                    <p><strong>Kết thúc lúc:</strong> @Model.EndedAt.Value.ToString("HH:mm dd/MM/yyyy")</p>
                }
            </div>
            <div class="col-md-6">
                @if (Model.Status == SessionStatus.Scheduled || Model.Status == SessionStatus.InProgress)
                {
                    <div class="mb-3">
                        <strong>Phòng học:</strong>
                        @if (!string.IsNullOrEmpty(Model.MeetingLink))
                        {
                            <div class="mt-1">
                                <a href="@Model.MeetingLink" target="_blank" class="btn btn-success">
                                    🔗 Vào phòng học (Meet/Zoom)
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted mt-1"><em>Gia sư chưa cập nhật đường dẫn phòng học.</em></div>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mb-3">
                        <strong>Ghi chú:</strong>
                        <div class="border rounded p-2 mt-1 bg-light">@Model.Notes</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CancellationReason))
                {
                    <div>
                        <strong>Lý do huỷ:</strong>
                        <div class="border rounded p-2 mt-1 bg-light text-danger">@Model.CancellationReason</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
