@model IEnumerable<EduMatch.Models.Notification>
@{
    ViewData["Title"] = "Thông báo";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
            🔔 Thông báo
            @if (unreadCount > 0)
            {
                <span class="badge bg-danger ms-2">@unreadCount</span>
            }
        </h2>
        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllNotificationsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-check-all"></i> Đánh dấu tất cả đã đọc
                </button>
            </form>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-bell-slash"></i> Chưa có thông báo nào.
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var notification in Model)
            {
                <div class="list-group-item @(!notification.IsRead ? "list-group-item-warning" : "") d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary">@notification.Type</span>
                            <strong>@notification.Title</strong>
                            @if (!notification.IsRead)
                            {
                                <span class="badge bg-danger">Mới</span>
                            }
                        </div>
                        <p class="mb-1 mt-1">@notification.Message</p>
                        <small class="text-muted">@notification.CreatedAt.ToString("HH:mm dd/MM/yyyy")</small>
                        @if (!string.IsNullOrEmpty(notification.ActionUrl))
                        {
                            <br>
                            <a href="@notification.ActionUrl" class="btn btn-sm btn-link p-0 mt-1">
                                Xem chi tiết →
                            </a>
                        }
                    </div>
                    @if (!notification.IsRead)
                    {
                        <form asp-action="MarkNotificationRead" asp-route-id="@notification.Id" method="post" class="ms-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Đánh dấu đã đọc">
                                <i class="bi bi-check"></i>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>
