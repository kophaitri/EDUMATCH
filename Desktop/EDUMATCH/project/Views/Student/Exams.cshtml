@model IEnumerable<EduMatch.Controllers.StudentController.StudentExamViewModel>
@{
    ViewData["Title"] = "Bài thi của tôi";
}

<div class="container mt-4">
    <h2>📋 Bài thi có thể làm</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Chưa có bài thi nào available.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var exam in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">@exam.SubjectName</h5>
                        </div>
                        <div class="card-body">
                            <h6 class="card-title">@exam.Title</h6>
                            <p class="card-text small">
                                <i class="bi bi-clock"></i> @exam.DurationMinutes phút<br>
                                <i class="bi bi-trophy"></i> Điểm đạt: @exam.PassingScore%<br>
                                <i class="bi bi-arrow-repeat"></i> Số lần làm lại: @exam.MaxRetakes
                            </p>
                            @if (exam.HasTaken)
                            {
                                <span class="badge bg-warning text-dark">
                                    Đã làm @exam.TakenCount/@exam.MaxRetakes lần
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">Chưa làm</span>
                            }
                        </div>
                        <div class="card-footer">
                            @if (exam.CanRetake)
                            {
                                <a asp-action="TakeExam" asp-route-examId="@exam.Id" class="btn btn-primary w-100">
                                    <i class="bi bi-pencil"></i> @(exam.HasTaken ? "Làm lại" : "Bắt đầu làm")
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100" disabled>
                                    <i class="bi bi-lock"></i> Hết lượt làm
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        <a asp-action="ExamHistory" class="btn btn-outline-primary">
            <i class="bi bi-clock-history"></i> Xem lịch sử bài làm
        </a>
    </div>
</div>