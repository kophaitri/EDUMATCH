@{
    ViewData["Title"] = "Tìm kiếm gia sư";
    var tutors = (List<TutorProfile>)ViewBag.Tutors;
    var subjects = (List<Subject>)ViewBag.Subjects;
    var gradeLevels = (List<GradeLevel>)ViewBag.GradeLevels;
}

@section Styles {
    @await Html.PartialAsync("_AuthStyles")
}

<div class="min-h-screen max-w-[1200px] mx-auto px-6 py-12 font-body">
    <!-- Header -->
    <header class="mb-12">
        <div class="flex items-center gap-2 mb-4">
            <a href="/" class="text-[10px] tracking-[0.2em] font-bold uppercase text-gray-5 no-underline hover:text-black transition-colors">EDUMATCH</a>
            <span class="text-[10px] text-gray-5">/</span>
            <span class="text-[10px] tracking-[0.2em] font-bold uppercase text-gray-5">TIM GIA SU</span>
        </div>
        <h1 class="title-main text-5xl md:text-6xl leading-none mb-3">Tìm gia sư</h1>
        <p class="accent-italic text-lg text-gray-5">Tìm gia sư phù hợp với nhu cầu học tập của bạn</p>
    </header>

    <!-- Search & Filter -->
    <div class="bg-white rounded-[14px] p-6 shadow-[0_4px_40px_rgba(0,0,0,0.07)] border border-gray-7 mb-8 card-fade-in">
        <form method="get" class="flex flex-col md:flex-row gap-3">
            <div class="flex-1">
                <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Nhập môn học, tên gia sư..."
                       class="w-full h-12 px-5 rounded-full border border-gray-7 bg-gray-8 text-sm font-medium focus:outline-none focus:border-gray-4 transition-colors" />
            </div>
            <select name="subjectId"
                    class="h-12 px-4 rounded-full border border-gray-7 bg-gray-8 text-sm font-medium focus:outline-none focus:border-gray-4 transition-colors appearance-none">
                <option value="">-- Môn học --</option>
                @foreach (var s in subjects)
                {
                    <option value="@s.Id" selected="@(ViewBag.SubjectId != null && (int)ViewBag.SubjectId == s.Id)">@s.Name</option>
                }
            </select>
            <select name="gradeLevelId"
                    class="h-12 px-4 rounded-full border border-gray-7 bg-gray-8 text-sm font-medium focus:outline-none focus:border-gray-4 transition-colors appearance-none">
                <option value="">-- Cấp độ --</option>
                @foreach (var g in gradeLevels)
                {
                    <option value="@g.Id" selected="@(ViewBag.GradeLevelId != null && (int)ViewBag.GradeLevelId == g.Id)">@g.Name</option>
                }
            </select>
            <button type="submit"
                    class="h-12 px-8 rounded-full bg-black text-white text-sm font-semibold hover:opacity-90 transition-all btn-transition">
                Tìm kiếm
            </button>
        </form>

        <!-- Quick tags -->
        <div class="flex flex-wrap gap-2 mt-4 justify-center">
            <a href="/Student/Search?keyword=Toán" class="px-3 py-1 bg-gray-8 border border-gray-7 rounded-full text-xs font-medium text-gray-4 no-underline hover:border-gray-4 hover:text-black transition-all">Toán học</a>
            <a href="/Student/Search?keyword=IELTS" class="px-3 py-1 bg-gray-8 border border-gray-7 rounded-full text-xs font-medium text-gray-4 no-underline hover:border-gray-4 hover:text-black transition-all">IELTS</a>
            <a href="/Student/Search?keyword=Hóa" class="px-3 py-1 bg-gray-8 border border-gray-7 rounded-full text-xs font-medium text-gray-4 no-underline hover:border-gray-4 hover:text-black transition-all">Hóa học</a>
            <a href="/Student/Search?keyword=Python" class="px-3 py-1 bg-gray-8 border border-gray-7 rounded-full text-xs font-medium text-gray-4 no-underline hover:border-gray-4 hover:text-black transition-all">Lập trình</a>
            <a href="/Student/Search?keyword=Piano" class="px-3 py-1 bg-gray-8 border border-gray-7 rounded-full text-xs font-medium text-gray-4 no-underline hover:border-gray-4 hover:text-black transition-all">Piano</a>
            <a href="/Student/Search?keyword=Tiếng Nhật" class="px-3 py-1 bg-gray-8 border border-gray-7 rounded-full text-xs font-medium text-gray-4 no-underline hover:border-gray-4 hover:text-black transition-all">Tiếng Nhật</a>
            @if (!string.IsNullOrEmpty(ViewBag.Keyword as string) || ViewBag.SubjectId != null || ViewBag.GradeLevelId != null)
            {
                <a href="/Student/Search" class="px-3 py-1 bg-gray-8 border border-gray-3 rounded-full text-xs font-bold text-gray-3 no-underline hover:bg-gray-3 hover:text-white transition-all">Xoá bộ lọc</a>
            }
        </div>
    </div>

    <!-- Results -->
    @if (!tutors.Any())
    {
        <div class="bg-white rounded-[14px] p-16 shadow-[0_4px_40px_rgba(0,0,0,0.07)] border border-gray-7 border-dashed text-center card-fade-in">
            <span class="material-symbols-outlined text-gray-6 text-5xl mb-4 block">search_off</span>
            <h3 class="text-xl font-display font-black mb-2">Không tìm thấy gia sư phù hợp</h3>
            <p class="text-gray-5 text-sm">Thử thay đổi bộ lọc hoặc từ khoá khác</p>
        </div>
    }
    else
    {
        <div class="flex items-center justify-between mb-6">
            <p class="text-sm text-gray-5 m-0">Tìm thấy <strong class="text-black">@tutors.Count</strong> gia sư</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var tutor in tutors)
            {
                <a asp-action="TutorProfile" asp-route-id="@tutor.UserId"
                   class="bg-white rounded-[14px] shadow-[0_4px_40px_rgba(0,0,0,0.07)] border border-gray-7 overflow-hidden no-underline text-inherit hover:border-gray-4 hover:shadow-[0_8px_50px_rgba(0,0,0,0.12)] transition-all card-fade-in block">
                    <div class="p-6">
                        <!-- Avatar + Name -->
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-7 flex-shrink-0 border-2 border-white shadow-sm">
                                @if (!string.IsNullOrEmpty(tutor.User.AvatarUrl))
                                {
                                    <img src="@tutor.User.AvatarUrl" alt="" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center bg-gray-7 text-gray-4 font-bold text-lg">
                                        @tutor.User.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                }
                            </div>
                            <div>
                                <h3 class="text-base font-bold m-0 leading-tight flex items-center gap-1">
                                    @tutor.User.FullName
                                    @if (tutor.IsVerified)
                                    {
                                        <span class="material-symbols-outlined text-green-600" style="font-size: 16px;">verified</span>
                                    }
                                </h3>
                                <p class="text-xs text-gray-5 m-0">@tutor.Education</p>
                            </div>
                        </div>

                        <!-- Bio -->
                        <p class="text-sm text-gray-4 leading-relaxed m-0 mb-4 line-clamp-2">@(tutor.Bio != null && tutor.Bio.Length > 80 ? tutor.Bio[..80] + "..." : tutor.Bio ?? "Chưa có giới thiệu")</p>

                        <!-- Subjects -->
                        <div class="flex flex-wrap gap-1 mb-4">
                            @foreach (var ts in tutor.TutorSubjects.Take(3))
                            {
                                <span class="px-2 py-0.5 bg-gray-8 text-gray-4 text-[10px] font-bold tracking-wider uppercase rounded-full">@ts.Subject.Name</span>
                            }
                            @if (tutor.TutorSubjects.Count > 3)
                            {
                                <span class="text-[10px] text-gray-5 font-medium self-center">+@(tutor.TutorSubjects.Count - 3)</span>
                            }
                        </div>

                        <!-- Price + Rating -->
                        <div class="flex items-center justify-between pt-4 border-t border-gray-7">
                            <span class="text-sm font-bold" style="color: #16a34a;">@tutor.HourlyRateMin.ToString("N0") - @tutor.HourlyRateMax.ToString("N0") <span class="text-xs text-gray-5 font-normal">VNĐ/h</span></span>
                            <span class="text-sm text-gray-4">
                                <span style="color: #f5a623;">&#9733;</span>
                                <span class="font-bold">@tutor.AvgRating.ToString("0.0")</span>
                                <span class="text-xs text-gray-5">(@tutor.TotalReviews)</span>
                            </span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>
