@{
    ViewData["Title"] = "Tìm kiếm gia sư";
    var tutors = (List<TutorProfile>)ViewBag.Tutors;
    var subjects = (List<Subject>)ViewBag.Subjects;
    var gradeLevels = (List<GradeLevel>)ViewBag.GradeLevels;
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- Search Header -->
<section class="search-section" style="margin: -16px -12px 0; border-top: none;">
    <h2 class="search-title">Tìm gia sư phù hợp với bạn</h2>
    <form method="get" class="search-box">
        <input class="search-input" type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Nhập môn học, tên gia sư..." />
        <select name="subjectId" class="search-select">
            <option value="">-- Môn học --</option>
            @foreach (var s in subjects)
            {
                <option value="@s.Id" selected="@(ViewBag.SubjectId != null && (int)ViewBag.SubjectId == s.Id)">@s.Name</option>
            }
        </select>
        <select name="gradeLevelId" class="search-select">
            <option value="">-- Cấp độ --</option>
            @foreach (var g in gradeLevels)
            {
                <option value="@g.Id" selected="@(ViewBag.GradeLevelId != null && (int)ViewBag.GradeLevelId == g.Id)">@g.Name</option>
            }
        </select>
        <button type="submit" class="search-btn">Tìm kiếm</button>
    </form>
    <div class="search-tags">
        <a href="/Student/Search?keyword=Toán" class="search-tag">Toán học</a>
        <a href="/Student/Search?keyword=IELTS" class="search-tag">IELTS</a>
        <a href="/Student/Search?keyword=Hóa" class="search-tag">Hóa học</a>
        <a href="/Student/Search?keyword=Python" class="search-tag">Lập trình</a>
        <a href="/Student/Search?keyword=Piano" class="search-tag">Piano</a>
        <a href="/Student/Search?keyword=Tiếng Nhật" class="search-tag">Tiếng Nhật</a>
        @if (!string.IsNullOrEmpty(ViewBag.Keyword as string) || ViewBag.SubjectId != null || ViewBag.GradeLevelId != null)
        {
            <a href="/Student/Search" class="search-tag" style="border-color: var(--gray-3); color: var(--gray-3);">Xoá bộ lọc</a>
        }
    </div>
</section>

<!-- Results -->
<div style="max-width: 1100px; margin: 40px auto; padding: 0 20px;">
    @if (!tutors.Any())
    {
        <div style="text-align: center; padding: 60px 20px;">
            <span class="material-symbols-outlined" style="font-size: 48px; color: var(--gray-5);">search_off</span>
            <h3 style="font-family: var(--font-display); font-weight: 900; margin-top: 16px;">Không tìm thấy gia sư phù hợp</h3>
            <p style="color: var(--gray-5); margin-top: 8px;">Thử thay đổi bộ lọc hoặc từ khoá khác</p>
        </div>
    }
    else
    {
        <p style="color: var(--gray-5); margin-bottom: 24px; font-size: 14px;">Tìm thấy <strong style="color: var(--black);">@tutors.Count</strong> gia sư</p>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var tutor in tutors)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm" style="border-radius: var(--radius-md); overflow: hidden; transition: all 0.3s var(--ease-out);">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div style="width: 50px; height: 50px; border-radius: 50%; overflow: hidden; background: var(--gray-7); flex-shrink: 0;">
                                    @if (!string.IsNullOrEmpty(tutor.User.AvatarUrl))
                                    {
                                        <img src="@tutor.User.AvatarUrl" alt="" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--gray-7); color: var(--gray-4); font-weight: 700; font-size: 18px;">
                                            @tutor.User.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">
                                        @tutor.User.FullName
                                        @if (tutor.IsVerified)
                                        {
                                            <span style="display: inline-block; width: 14px; height: 14px; background: #16a34a; border-radius: 50%; color: white; font-size: 9px; line-height: 14px; text-align: center; margin-left: 4px; vertical-align: middle;" title="Đã xác minh">&#10003;</span>
                                        }
                                    </h6>
                                    <small style="color: var(--gray-5);">@tutor.Education</small>
                                </div>
                            </div>
                            <p style="font-size: 13px; color: var(--gray-4); line-height: 1.6; min-height: 40px;">@(tutor.Bio != null && tutor.Bio.Length > 80 ? tutor.Bio[..80] + "..." : tutor.Bio)</p>
                            <div class="mb-3">
                                @foreach (var ts in tutor.TutorSubjects.Take(3))
                                {
                                    <span style="display: inline-block; padding: 3px 10px; background: var(--gray-8); border: 1px solid var(--gray-7); border-radius: 100px; font-size: 11px; font-weight: 600; color: var(--gray-3); margin-right: 4px; margin-bottom: 4px;">@ts.Subject.Name</span>
                                }
                                @if (tutor.TutorSubjects.Count > 3)
                                {
                                    <span style="font-size: 11px; color: var(--gray-5);">+@(tutor.TutorSubjects.Count - 3)</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong style="font-size: 14px; color: var(--black);">@tutor.HourlyRateMin.ToString("N0") - @tutor.HourlyRateMax.ToString("N0") VNĐ/h</strong>
                                <span style="font-size: 13px; color: var(--gray-4);">
                                    <span style="color: #f5a623;">&#9733;</span> @tutor.AvgRating.ToString("0.0")
                                    <span style="font-size: 11px;">(@tutor.TotalReviews)</span>
                                </span>
                            </div>
                        </div>
                        <div style="padding: 0 16px 16px;">
                            <a asp-action="TutorProfile" asp-route-id="@tutor.UserId"
                               style="display: block; text-align: center; padding: 10px; background: var(--black); color: var(--white); border-radius: 100px; font-size: 13px; font-weight: 700; text-decoration: none; transition: background 0.2s;">
                                Xem hồ sơ
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
