@model List<Session>
@{ ViewData["Title"] = "Lịch học của tôi"; }

<h4 class="mb-3">Lịch học của tôi</h4>

<ul class="nav nav-tabs mb-3" id="scheduleTab">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#listView">Danh sách</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#calendarView">Lịch</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="listView">
        @if (!Model.Any())
        {
            <div class="alert alert-info">Chưa có buổi học nào được lên lịch.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr><th>Gia sư</th><th>Môn học</th><th>Thời gian</th><th>Thời lượng</th><th>Trạng thái</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.Contract.Tutor.FullName</td>
                                <td>@s.Contract.Subject.Name</td>
                                <td>@s.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@s.DurationMinutes phút</td>
                                <td>
                                    @switch (s.Status)
                                    {
                                        case SessionStatus.Scheduled:
                                            <span class="badge bg-info text-dark">Sắp tới</span> break;
                                        case SessionStatus.InProgress:
                                            <span class="badge bg-primary">Đang diễn ra</span> break;
                                        case SessionStatus.Completed:
                                            <span class="badge bg-success">Hoàn thành</span> break;
                                        case SessionStatus.NoShow:
                                            <span class="badge bg-dark">Vắng mặt</span> break;
                                        default:
                                            <span class="badge bg-secondary">Đã huỷ</span> break;
                                    }
                                </td>
                                <td><a asp-action="SessionDetail" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="tab-pane fade" id="calendarView">
        <div id="calendar"></div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script>
        document.querySelector('[data-bs-target="#calendarView"]').addEventListener('shown.bs.tab', function () {
            if (!window.calendarInit) {
                window.calendarInit = true;
                var calendarEl = document.getElementById('calendar');
                var calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    locale: 'vi',
                    events: [
                        @foreach (var s in Model)
                        {
                            @Html.Raw($@"{{
                                title: '{s.Contract.Tutor.FullName} - {s.Contract.Subject.Name}',
                                start: '{s.ScheduledAt:yyyy-MM-ddTHH:mm:ss}',
                                url: '/Student/SessionDetail/{s.Id}',
                                color: '{(s.Status == SessionStatus.Completed ? "#198754" : s.Status == SessionStatus.Cancelled ? "#6c757d" : "#0dcaf0")}'
                            }},")
                        }
                    ]
                });
                calendar.render();
            }
        });
    </script>
}
