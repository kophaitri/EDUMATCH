@model TutorDashboardDto
@{ ViewData["Title"] = "Dashboard Gia sư"; }

@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

<div class="d-flex align-items-center gap-3 mb-4">
    @if (Model.AvatarUrl != null)
    {
        <img src="@Model.AvatarUrl" class="rounded-circle" style="width:56px;height:56px;object-fit:cover" alt="avatar" />
    }
    <div>
        <h4 class="mb-0">Xin chào, @Model.FullName</h4>
        <span class="text-muted">
            @if (Model.IsVerified) { <span class="badge bg-success">Đã xác minh</span> }
            else { <span class="badge bg-warning text-dark">Chờ xác minh</span> }
            &nbsp; Điểm uy tín: <strong>@Model.ReputationScore.ToString("F1")</strong>
            &nbsp; Đánh giá: <strong>@Model.AvgRating.ToString("F1") ⭐ (@Model.TotalReviews)</strong>
        </span>
    </div>
</div>

<!-- Thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-primary">@Model.ActiveContracts</div>
                <div class="text-muted small">Hợp đồng đang chạy</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-warning">@Model.PendingBookings</div>
                <div class="text-muted small">Yêu cầu chờ duyệt</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-success">@Model.SessionsThisMonth</div>
                <div class="text-muted small">Buổi học tháng này</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-0 shadow-sm h-100">
            <div class="card-body py-3">
                <div class="fs-2 fw-bold text-info">@Model.UpcomingSessions</div>
                <div class="text-muted small">Buổi sắp tới</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Ví -->
    <div class="col-md-4">
        <div class="card bg-success text-white shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title opacity-75">Số dư ví</h6>
                <h3 class="fw-bold">@Model.WalletBalance.ToString("N0") VNĐ</h3>
                <small class="opacity-75">Tổng đã kiếm: @Model.TotalEarned.ToString("N0") VNĐ</small>
                <div class="mt-3">
                    <a asp-action="Wallet" class="btn btn-light btn-sm">Quản lý ví</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Menu quản lý -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header"><strong>Quản lý</strong></div>
            <div class="list-group list-group-flush">
                <a asp-action="Bookings" class="list-group-item list-group-item-action">
                    Yêu cầu đặt lịch
                    @if (Model.PendingBookings > 0) { <span class="badge bg-warning text-dark float-end">@Model.PendingBookings</span> }
                </a>
                <a asp-action="Contracts" class="list-group-item list-group-item-action">Hợp đồng của tôi</a>
                <a asp-action="ManageSubjects" class="list-group-item list-group-item-action">Môn dạy & Học phí</a>
                <a asp-action="Posts" class="list-group-item list-group-item-action">Bài đăng của tôi</a>
            </div>
        </div>
    </div>
</div>

<!-- Thống kê nhanh - 3 card -->
<h6 class="text-muted text-uppercase fw-semibold mb-3" style="letter-spacing:.08em;font-size:.72rem;">Thống kê</h6>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-action="StatsSessions" class="text-decoration-none">
            <div class="card shadow-sm border-0 h-100 tutor-stat-card">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="tutor-stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Thống kê buổi học</div>
                        <div class="text-muted small">Xem theo tháng / năm</div>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="StatsRevenue" class="text-decoration-none">
            <div class="card shadow-sm border-0 h-100 tutor-stat-card">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="tutor-stat-icon bg-success-subtle text-success">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Doanh thu dự kiến</div>
                        <div class="text-muted small">Xem theo tháng / năm</div>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="StatsReputation" class="text-decoration-none">
            <div class="card shadow-sm border-0 h-100 tutor-stat-card">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="tutor-stat-icon bg-warning-subtle text-warning">
                        <i class="bi bi-star-half"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">Điểm uy tín</div>
                        <div class="text-muted small">Đánh giá & lịch sử</div>
                    </div>
                    <i class="bi bi-chevron-right ms-auto text-muted"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Đánh giá gần đây -->
@if (Model.RecentReviews.Any())
{
    <div class="card shadow-sm">
        <div class="card-header"><strong>Đánh giá gần đây</strong></div>
        <div class="card-body p-0">
            @foreach (var r in Model.RecentReviews)
            {
                <div class="px-3 py-2 border-bottom">
                    <div class="d-flex justify-content-between">
                        <strong>@r.ReviewerName</strong>
                        <span class="text-warning">@string.Concat(Enumerable.Repeat("⭐", r.Rating))</span>
                    </div>
                    @if (r.Comment != null) { <p class="mb-0 text-muted small">@r.Comment</p> }
                    <small class="text-muted">@r.CreatedAt.ToString("dd/MM/yyyy")</small>
                </div>
            }
        </div>
    </div>
}
