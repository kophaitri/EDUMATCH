@model TutorSessionStatsDto
@{ ViewData["Title"] = "Thống kê buổi học"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Thống kê buổi học — @Model.Year</h4>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
</div>

@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

<!-- Chọn năm -->
<form method="get" class="d-flex gap-2 mb-4">
    <select name="year" class="form-select w-auto">
        @for (int y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 3; y--)
        {
            <option value="@y" selected="@(Model.Year == y)">@y</option>
        }
    </select>
    <button type="submit" class="btn btn-primary">Xem</button>
</form>

<!-- Tóm tắt -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center border-0 bg-success text-white shadow-sm">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold">@Model.TotalCompleted</div>
                <div class="small">Đã hoàn thành</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 bg-warning text-dark shadow-sm">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold">@Model.TotalScheduled</div>
                <div class="small">Đã lên lịch</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center border-0 bg-danger text-white shadow-sm">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold">@Model.TotalCancelled</div>
                <div class="small">Đã hủy</div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng theo tháng -->
<div class="table-responsive">
    <table class="table table-bordered align-middle text-center">
        <thead class="table-dark">
            <tr><th>Tháng</th><th class="text-success">Hoàn thành</th><th class="text-warning">Lên lịch</th><th class="text-danger">Hủy</th><th>Tổng</th></tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Months)
            {
                <tr class="@(m.Total == 0 ? "text-muted" : "")">
                    <td class="fw-semibold">@m.MonthName</td>
                    <td>@(m.Completed > 0 ? m.Completed.ToString() : "—")</td>
                    <td>@(m.Scheduled > 0 ? m.Scheduled.ToString() : "—")</td>
                    <td>@(m.Cancelled > 0 ? m.Cancelled.ToString() : "—")</td>
                    <td class="fw-bold">@(m.Total > 0 ? m.Total.ToString() : "—")</td>
                </tr>
            }
        </tbody>
        <tfoot class="table-light fw-bold">
            <tr>
                <td>Tổng năm</td>
                <td class="text-success">@Model.TotalCompleted</td>
                <td class="text-warning">@Model.TotalScheduled</td>
                <td class="text-danger">@Model.TotalCancelled</td>
                <td>@(Model.TotalCompleted + Model.TotalScheduled + Model.TotalCancelled)</td>
            </tr>
        </tfoot>
    </table>
</div>
