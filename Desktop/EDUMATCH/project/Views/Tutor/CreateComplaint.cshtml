@{
    ViewData["Title"] = "Khiếu nại đánh giá";
    var reviewId = ViewBag.ReviewId;
    var reviewerName = ViewBag.ReviewerName;
    var reviewComment = ViewBag.ReviewComment;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">⚠️ Khiếu nại đánh giá</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <strong>Đánh giá từ:</strong> @reviewerName<br>
                <strong>Nội dung:</strong> @reviewComment
            </div>

            <form asp-action="CreateComplaint" asp-route-id="@reviewId" method="post">
                @Html.AntiForgeryToken()
                
                <div class="mb-3">
                    <label class="form-label">Lý do khiếu nại <span class="text-danger">*</span></label>
                    <select name="reason" class="form-select" required>
                        <option value="">-- Chọn lý do --</option>
                        <option value="Spam">Spam/Quảng cáo</option>
                        <option value="Inappropriate">Nội dung không phù hợp</option>
                        <option value="False">Thông tin sai sự thật</option>
                        <option value="Offensive">Ngôn từ xúc phạm</option>
                        <option value="Other">Khác</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Chi tiết <span class="text-danger">*</span></label>
                    <textarea name="details" class="form-control" rows="5" required
                              placeholder="Mô tả chi tiết lý do khiếu nại..."></textarea>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Reviews" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-exclamation-triangle"></i> Gửi khiếu nại
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>