@model EditTutorPostViewModel
@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0">Chỉnh sửa bài viết</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EditPost" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="CurrentThumbnailUrl" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tiêu đề</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold">Nội dung</label>
                            <textarea asp-for="Content" class="form-control" rows="10"></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Ảnh bìa</label>
                            @if (!string.IsNullOrEmpty(Model.CurrentThumbnailUrl))
                            {
                                <div class="mb-2">
                                    <img src="@Model.CurrentThumbnailUrl" alt="Ảnh bìa hiện tại"
                                         class="img-thumbnail" style="max-height: 150px;" />
                                    <small class="text-muted d-block mt-1">Ảnh bìa hiện tại</small>
                                </div>
                            }
                            <input asp-for="ThumbnailFile" class="form-control" type="file" accept="image/*" />
                            <small class="text-muted">Chọn ảnh mới để thay thế ảnh cũ.</small>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                                <label asp-for="IsPublished" class="form-check-label">Đăng công khai</label>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Posts" class="btn btn-outline-secondary">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
