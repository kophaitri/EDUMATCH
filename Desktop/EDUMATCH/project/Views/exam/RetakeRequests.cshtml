@model EduMatch.Models.ExamSubmission
@{
    ViewData["Title"] = "Yêu cầu làm lại";
}

<h2>🔄 Yêu cầu làm lại - @Model.Student.FullName</h2>

<a asp-action="SubmissionDetail" asp-route-examId="@Model.ExamId" asp-route-subId="@Model.Id" class="btn btn-secondary mb-3">
    <i class="bi bi-arrow-left"></i> Quay lại
</a>

<div class="card shadow-sm">
    <div class="card-header">
        <h5>Thông tin bài làm</h5>
    </div>
    <div class="card-body">
        <p><strong>Lần làm:</strong> @Model.RetakeNumber</p>
        <p><strong>Điểm:</strong> @Model.TotalScore (@Model.Percentage.ToString("F1")%)</p>
        <p><strong>Trạng thái:</strong> @(Model.IsPassed ? "✓ Đạt" : "✗ Không đạt")</p>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header">
        <h5>Danh sách yêu cầu</h5>
    </div>
    <div class="card-body">
        @if (Model.RetakeRequests?.Any() == true)
        {
            @foreach (var request in Model.RetakeRequests)
            {
                <div class="border-bottom py-3">
                    <p><strong>Lý do:</strong> @request.Reason</p>
                    <p><small>Yêu cầu lúc: @request.RequestedAt.ToString("dd/MM HH:mm")</small></p>
                    
                    @if (request.IsApproved)
                    {
                        <span class="badge bg-success">✓ Đã duyệt</span>
                        <p><small>Phản hồi: @request.ResponseNote</small></p>
                    }
                    else if (request.RespondedAt.HasValue)
                    {
                        <span class="badge bg-danger">✗ Đã từ chối</span>
                        <p><small>Phản hồi: @request.ResponseNote</small></p>
                    }
                    else
                    {
                        <form asp-action="RespondRetakeRequest" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@request.Id" />
                            
                            <div class="mb-2">
                                <label class="form-label">Phản hồi</label>
                                <textarea name="responseNote" class="form-control" rows="2"></textarea>
                            </div>
                            
                            <div class="btn-group">
                                <button type="submit" name="isApproved" value="true" class="btn btn-success">
                                    ✓ Duyệt
                                </button>
                                <button type="submit" name="isApproved" value="false" class="btn btn-danger">
                                    ✗ Từ chối
                                </button>
                            </div>
                        </form>
                    }
                </div>
            }
        }
        else
        {
            <p class="text-muted">Chưa có yêu cầu làm lại nào.</p>
        }
    </div>
</div>