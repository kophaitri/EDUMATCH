@model IEnumerable<EduMatch.Controllers.Tutor.SubmissionListViewModel>
@{
    ViewData["Title"] = "Danh sách bài làm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>📊 @ViewBag.ExamTitle - Bài làm học viên</h2>
    <a asp-action="Edit" asp-route-id="@ViewBag.ExamId" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Chưa có học viên nào làm bài thi này.</div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Học viên</th>
                <th>Thời gian nộp</th>
                <th>Điểm</th>
                <th>Tỷ lệ</th>
                <th>Trạng thái</th>
                <th>Gian lận</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sub in Model)
            {
                <tr>
                    <td>
                        <strong>@sub.StudentName</strong><br>
                        <small class="text-muted">@sub.StudentEmail</small>
                    </td>
                    <td>@sub.SubmittedAt?.ToString("dd/MM HH:mm")</td>
                    <td><strong>@sub.TotalScore</strong></td>
                    <td>
                        <span class="badge @(sub.IsPassed ? "bg-success" : "bg-danger")">@sub.Percentage.ToString("F1")%</span>
                    </td>
                    <td><span class="badge bg-info">@sub.Status</span></td>
                    <td>
                        @if (sub.IsFlagged)
                        {
                            <span class="badge bg-warning text-dark">⚠️ @sub.FraudScore</span>
                        }
                        else
                        {
                            <span class="badge bg-success">✓</span>
                        }
                    </td>
                    <td>
                        <a asp-action="SubmissionDetail" asp-route-examId="@ViewBag.ExamId" asp-route-subId="@sub.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i> Xem chi tiết
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}