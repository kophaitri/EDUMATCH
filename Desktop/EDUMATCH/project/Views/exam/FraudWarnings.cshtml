@model EduMatch.Models.ExamSubmission
@{
    ViewData["Title"] = "Cảnh báo gian lận";
}

<h2>⚠️ Cảnh báo gian lận - @Model.Student.FullName</h2>

<a asp-action="SubmissionDetail" asp-route-examId="@Model.ExamId" asp-route-subId="@Model.Id" class="btn btn-secondary mb-3">
    <i class="bi bi-arrow-left"></i> Quay lại
</a>

<div class="card shadow-sm">
    <div class="card-header bg-warning">
        <h5>📊 Thông số gian lận</h5>
    </div>
    <div class="card-body">
        <p><strong>Điểm gian lận:</strong> @Model.FraudScore</p>
        <p><strong>Trạng thái:</strong> @(Model.IsFlagged ? "⚠️ Có cảnh báo" : "✓ Bình thường")</p>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header">
        <h5>Danh sách cảnh báo</h5>
    </div>
    <div class="card-body">
        @if (Model.FraudWarnings?.Any() == true)
        {
            @foreach (var warning in Model.FraudWarnings)
            {
                <div class="alert alert-warning">
                    <strong>@warning.WarningType</strong> - @warning.DetectedAt.ToString("dd/MM HH:mm")<br>
                    <small>@warning.Details</small>
                    
                    <form asp-action="ResolveFraudWarning" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="warningId" value="@warning.Id" />
                        <input type="text" name="resolutionNote" class="form-control mb-2" placeholder="Ghi chú xử lý..." />
                        <button type="submit" class="btn btn-sm btn-success">✓ Đánh dấu đã xử lý</button>
                    </form>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Không có cảnh báo nào.</p>
        }
    </div>
</div>